# =========================
# llama.cpp / Docker
# =========================
LLAMA_PORT=8080

# =========================
# Model
# HF_REPO: HuggingFace repository (e.g. unsloth/gemma-4-26B-A4B-it-GGUF)
# MODEL_DIR: local folder name under models/
# MODEL_FILENAME: exact .gguf filename from the HuggingFace repo page
#
# To switch model: comment the active block, uncomment the other,
# and update N_CPU_MOE + CTX_SIZE accordingly (see notes below).
# =========================

# --- Gemma 4 26B-A4B · Q4_K_M · N_CPU_MOE=15 · CTX_SIZE=131072 · N_GPU_LAYERS=-1 · KV_OFFLOAD=true ---
# HF_REPO=unsloth/gemma-4-26B-A4B-it-GGUF
# MODEL_FILENAME=gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
# MODEL_DIR=gemma-4-26b-a4b-it-q4km

# --- Qwen3.6-35B-A3B · Q4_K_M · N_CPU_MOE=28 · CTX_SIZE=262144 · N_GPU_LAYERS=-1 · KV_OFFLOAD=true ---
HF_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
MODEL_FILENAME=Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
MODEL_DIR=qwen3.6-35b-a3b-q4km

# =========================
# Model Config
# =========================
N_GPU_LAYERS=-1
CTX_SIZE=65536
MAX_TOKENS=32768
REASONING=on

# false = KV-cache in RAM
# true  = KV-cache on GPU
KV_OFFLOAD=true
# =========================
# MoE CPU Offload
# Offloads N expert layers to CPU — keeps attention on GPU.
# Set to 0 to disable. Tune to find the GPU VRAM sweet spot.
#
# Tuning guide (RTX 4070, 12 GB VRAM):
#   Se OOM → aumente de 2-3 em 2-3 e reinicie.
#   If VRAM usage < 10 GB → decrease by 2-3 for more GPU throughput.
#   Target: load succeeds + nvidia-smi shows 10-11.5 GB used.
# =========================
# N_CPU_MOE=15 #Gemma 4 26B-A4B - NVIDIA4070
N_CPU_MOE=25 #Qwen3.6-35B-A3B - NVIDIA4070

# =========================
# Memory
# NO_MMAP: load model fully into RAM (avoids page faults, faster inference)
# MLOCK: pin model in RAM to prevent OS swap (requires enough free RAM)
# =========================
NO_MMAP=true
MLOCK=true

# =========================
# KV Cache
# turbo4/turbo3 require the TheTom/llama-cpp-turboquant fork (WHT + PolarQuant).
# Fallback for standard llama.cpp: q8_0 (best quality) or q4_0 (less VRAM).
# =========================
CACHE_TYPE_K=turbo4
CACHE_TYPE_V=turbo3

# =========================
# Active sampling preset
# =========================
# Gemma 4 — General (official recommendation):
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=64
# MIN_P=0.0
# PRESENCE_PENALTY=0.0
# REPEAT_PENALTY=1.0

# =========================
# Recommended presets — gemma-4-26B-A4B-it
# (active above — official recommendation)
# =========================

# =========================
# Recommended presets — qwen3.6-35b-a3b
# =========================
# Thinking / general:
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=20
# MIN_P=0.0
# PRESENCE_PENALTY=1.5
# REPEAT_PENALTY=1.0

# Thinking / precise coding:
# TEMPERATURE=0.6
# TOP_P=0.95
# TOP_K=20
# MIN_P=0.0
# PRESENCE_PENALTY=0.0
# REPEAT_PENALTY=1.0

# Instruct / non-thinking / general:
TEMPERATURE=0.7
TOP_P=0.8
TOP_K=20
MIN_P=0.0
PRESENCE_PENALTY=1.5
REPEAT_PENALTY=1.0

# Instruct / non-thinking / reasoning:
# TEMPERATURE=1.0
# TOP_P=1.0
# TOP_K=40
# MIN_P=0.0
# PRESENCE_PENALTY=2.0
# REPEAT_PENALTY=1.0
