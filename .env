# =========================
# llama.cpp / Docker
# =========================
LLAMA_PORT=8080

# =========================
# Model
# HF_REPO: HuggingFace repository
# MODEL_DIR: local folder name under models/
# MODEL_FILENAME: exact .gguf filename
# MTP_FILENAME: MTP draft model (subfolder path within the same repo)
# =========================

# --- Gemma 4 12B QAT · Q4_0 · CTX_SIZE=16384 · N_GPU_LAYERS=-1 · KV q8_0 ---
HF_REPO=google/gemma-4-12B-it-qat-q4_0-gguf
MODEL_FILENAME=gemma-4-12b-it-qat-q4_0.gguf
MODEL_DIR=gemma-4-12b-it-qat-q4_0
MTP_HF_REPO=Janvitos/gemma-4-12B-it-qat-assistant-MTP-Q8_0-GGUF
MTP_FILENAME=gemma-4-12B-it-qat-assistant-MTP-Q8_0.gguf

# =========================
# Model Config
# =========================
N_GPU_LAYERS=-1
CTX_SIZE=32768
MAX_TOKENS=16384
REASONING=on

# false = KV-cache in RAM
# true  = KV-cache on GPU
KV_OFFLOAD=true

# =========================
# Memory
# NO_MMAP: load model fully into RAM (avoids page faults, faster inference)
# MLOCK: pin model in RAM to prevent OS swap (requires enough free RAM)
# =========================
NO_MMAP=true
MLOCK=false

# =========================
# KV Cache quantization
# q8_0 = 8-bit, best quality without TurboQuant fork
# q4_0 = 4-bit, saves VRAM at cost of quality
# =========================
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q4_0

# =========================
# MTP (Multi-Token Prediction)
# MTP_DRAFT_N: max draft tokens per step (2–5 typical; higher = faster but less accurate)
# Set MTP_FILENAME= (empty) to disable MTP.
# =========================
MTP_DRAFT_N=2

# =========================
# Active sampling preset — Gemma 4 (official recommendation)
# =========================
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
MIN_P=0.0
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# =========================
# Recommended presets — Gemma 4 12B
# =========================
# Thinking / general (official):
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=64
# MIN_P=0.0
# PRESENCE_PENALTY=0.0
# REPEAT_PENALTY=1.0

# Instruct / non-thinking:
# TEMPERATURE=0.7
# TOP_P=0.95
# TOP_K=40
# MIN_P=0.0
# PRESENCE_PENALTY=0.0
# REPEAT_PENALTY=1.0
